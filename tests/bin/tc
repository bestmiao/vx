#!/usr/bin/env bash
echo "tc $*" >> "$TQ_TEST_ROOT/log"
ROOT="$TQ_TEST_ROOT/tc.root"
ING="$TQ_TEST_ROOT/tc.ingress"
case "$*" in
  "qdisc show dev "*)
    [ "$(cat "$ROOT" 2>/dev/null)" = "1" ] && echo "qdisc htb 1: root refcnt 2 r2q 10 default 0x30 direct_packets_stat 0 direct_qlen 1000"
    ;;
  "qdisc replace dev "*" root handle 1: htb"*)
    echo 1 > "$ROOT"
    ;;
  "qdisc del dev "*" root")
    echo 0 > "$ROOT"
    ;;
  "qdisc replace dev "*" handle ffff: ingress")
    echo 1 > "$ING"
    ;;
  "qdisc del dev "*" handle ffff: ingress")
    echo 0 > "$ING"
    ;;
  *)
    ;;
esac
exit 0
