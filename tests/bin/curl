#!/usr/bin/env bash
echo "curl $*" >> "$TQ_TEST_ROOT/log"
out=""
url=""
prev=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then out="$a"; prev=""; continue; fi
  case "$a" in
    -o) prev="-o" ;;
    http*|https*) url="$a" ;;
  esac
done
case "$url" in
  *install-release.sh*)
    mkdir -p "$(dirname "$out")"
    printf '#!/usr/bin/env bash\nexit 0\n' > "$out"
    chmod +x "$out"
    ;;
  *get.acme.sh*)
    mkdir -p "$(dirname "$out")"
    printf '#!/usr/bin/env sh\nexit 0\n' > "$out"
    ;;
  *api.ipify.org*)
    printf '198.51.100.20'
    ;;
  *)
    [ -n "$out" ] && : > "$out"
    ;;
esac
exit 0
